# Copy to .env (`make init` does it and sets chmod 600). Never commit .env.

# Shown in every alert and on the dashboard.
SERVER_NAME=vps.example.com

# --- WHM API -----------------------------------------------------------------
# WHM > Development > Manage API Tokens > Generate Token.
WHM_API_TOKEN=
WHM_USER=root
# The exporter runs on the same server, so it talks to WHM over loopback.
WHM_URL=https://127.0.0.1:2087
# The WHM certificate is issued for the hostname, not 127.0.0.1. Set WHM_URL to
# https://<your hostname>:2087 and this to true if you prefer full verification.
WHM_VERIFY_TLS=false

# Collectors to run: all, or a comma list of
# server,services,accounts,disk,ssl,cphulk,email,exim_queue
COLLECTORS=all
# Window for the per-user outgoing mail stats (seconds).
EMAIL_STATS_WINDOW=3600
# Group that can read /var/spool/exim/input. scripts/preflight.sh sets it.
EXIM_SPOOL_GID=12
LOG_LEVEL=INFO

# --- Grafana -----------------------------------------------------------------
# `make init` generates a random password if this is empty.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3000/

# --- Telegram alerts (optional) ----------------------------------------------
# Bot token from @BotFather; chat id of you or your group (groups are negative).
# Leave empty to keep alerts in the Alertmanager UI only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Prometheus storage --------------------------------------------------------
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=5GB
